{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder FoundationOgham/Assets": {
                    "watch": "@GEMROOT:FoundationOgham@/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder FoundationOgham/Registry": {
                    "watch": "@GEMROOT:FoundationOgham@/Registry",
                    "recursive": 1,
                    "order": 102
                }
            }
        }
    }
}
